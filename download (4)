/**
 * PROGRESS PAGE — Biophilic Minimalism
 * Daily score trend, weekly summary, highlights of improvements/regressions.
 * Tracks page view for analytics
 */
import { useEffect } from 'react';
import { useEco } from '@/contexts/EcoContext';
import { getImpactCategory, getWeeklyAverage, type DailyLog } from '@/lib/ecoStore';
import { pageEvents } from '@/lib/analytics';
import {
  AreaChart, Area, BarChart, Bar, Cell, XAxis, YAxis, Tooltip,
  ResponsiveContainer, CartesianGrid, ReferenceLine,
} from 'recharts';
import { TrendingDown, TrendingUp, Calendar, Award, AlertTriangle } from 'lucide-react';

const DAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return `${d.getMonth() + 1}/${d.getDate()}`;
}

function getDayLabel(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return DAY_LABELS[d.getDay()];
}

const CATEGORY_BG: Record<string, string> = {
  Low: 'bg-primary text-primary-foreground',
  Medium: 'bg-[oklch(0.72_0.14_75)] text-white',
  High: 'bg-destructive text-destructive-foreground',
};

function ScoreBar({ score, maxScore = 100 }: { score: number; maxScore?: number }) {
  const pct = (score / maxScore) * 100;
  const color =
    score <= 40 ? 'oklch(0.42 0.12 148)' :
    score <= 70 ? 'oklch(0.72 0.14 75)' :
    'oklch(0.577 0.245 27.325)';
  return (
    <div className="flex items-center gap-2">
      <div className="flex-1 h-2 bg-muted rounded-full overflow-hidden">
        <div
          className="h-full rounded-full transition-all duration-700"
          style={{ width: `${pct}%`, background: color }}
        />
      </div>
      <span className="text-xs font-['Fraunces'] font-bold w-8 text-right" style={{ color }}>
        {score}
      </span>
    </div>
  );
}

export default function Progress() {
  const { state } = useEco();

  // Track progress page view
  useEffect(() => {
    pageEvents.progressViewed();
  }, []);
  const logs = state.logs;

  if (logs.length === 0) {
    return (
      <div className="min-h-screen pb-24 px-4 pt-16 flex flex-col items-center justify-center">
        <div className="eco-card p-8 max-w-sm w-full text-center animate-fade-up">
          <Calendar size={48} className="text-primary mx-auto mb-4" />
          <h2 className="font-['Fraunces'] font-black text-xl text-foreground mb-2">No data yet</h2>
          <p className="text-sm text-muted-foreground">
            Start logging your daily habits to see your progress over time.
          </p>
        </div>
      </div>
    );
  }

  const weeklyAvg = getWeeklyAverage(logs);
  const weeklyAvgCategory = getImpactCategory(weeklyAvg);
  const recent7 = logs.slice(-7);
  const recent14 = logs.slice(-14);

  // Build chart data
  const chartData = recent7.map((log) => ({
    day: getDayLabel(log.date),
    date: formatDate(log.date),
    score: log.score,
    fill:
      log.score <= 40 ? 'oklch(0.42 0.12 148)' :
      log.score <= 70 ? 'oklch(0.72 0.14 75)' :
      'oklch(0.577 0.245 27.325)',
  }));

  // Trend: compare last 7 vs previous 7
  const prev7 = recent14.slice(0, recent14.length - recent7.length);
  const prevAvg = prev7.length > 0
    ? Math.round(prev7.reduce((s, l) => s + l.score, 0) / prev7.length)
    : null;
  const trendDiff = prevAvg !== null ? weeklyAvg - prevAvg : null;

  // Best and worst days
  const sortedByScore = [...recent7].sort((a, b) => a.score - b.score);
  const bestDay = sortedByScore[0];
  const worstDay = sortedByScore[sortedByScore.length - 1];

  // Category breakdown
  const categoryCounts = recent7.reduce(
    (acc, log) => {
      acc[log.category] = (acc[log.category] || 0) + 1;
      return acc;
    },
    {} as Record<string, number>
  );

  return (
    <div className="min-h-screen pb-24">
      {/* Header */}
      <div className="px-4 pt-10 pb-4">
        <p className="text-xs font-semibold text-primary uppercase tracking-widest mb-1">Analytics</p>
        <h1 className="font-['Fraunces'] font-black text-3xl text-foreground">
          Your Progress
        </h1>
        <p className="text-sm text-muted-foreground mt-1">
          {logs.length} day{logs.length !== 1 ? 's' : ''} tracked
        </p>
      </div>

      <div className="px-4 space-y-4">
        {/* Weekly Summary Card */}
        <div className="eco-card p-5 animate-fade-up">
          <div className="flex items-center justify-between mb-4">
            <h2 className="font-['Fraunces'] font-bold text-base text-foreground">
              Weekly Summary
            </h2>
            <span className={`text-xs font-semibold px-2.5 py-1 rounded-full ${CATEGORY_BG[weeklyAvgCategory]}`}>
              {weeklyAvgCategory} Impact
            </span>
          </div>
          <div className="grid grid-cols-3 gap-3 mb-4">
            <div className="text-center">
              <p className="text-2xl font-['Fraunces'] font-black text-primary">{weeklyAvg}</p>
              <p className="text-[10px] text-muted-foreground font-medium">Avg Score</p>
            </div>
            <div className="text-center">
              <p className="text-2xl font-['Fraunces'] font-black text-foreground">{recent7.length}</p>
              <p className="text-[10px] text-muted-foreground font-medium">Days</p>
            </div>
            <div className="text-center">
              {trendDiff !== null ? (
                <>
                  <div className="flex items-center justify-center gap-1">
                    {trendDiff < 0 ? (
                      <TrendingDown size={16} className="text-primary" />
                    ) : (
                      <TrendingUp size={16} className="text-[oklch(0.72_0.14_75)]" />
                    )}
                    <p className={`text-2xl font-['Fraunces'] font-black ${trendDiff < 0 ? 'text-primary' : 'text-[oklch(0.72_0.14_75)]'}`}>
                      {Math.abs(trendDiff)}
                    </p>
                  </div>
                  <p className="text-[10px] text-muted-foreground font-medium">vs Prev Week</p>
                </>
              ) : (
                <>
                  <p className="text-2xl font-['Fraunces'] font-black text-muted-foreground">—</p>
                  <p className="text-[10px] text-muted-foreground font-medium">vs Prev Week</p>
                </>
              )}
            </div>
          </div>

          {/* Trend message */}
          {trendDiff !== null && (
            <div className={`flex items-center gap-2 p-3 rounded-xl text-sm ${
              trendDiff < 0
                ? 'bg-primary/8 text-primary'
                : 'bg-[oklch(0.72_0.14_75)]/10 text-[oklch(0.55_0.13_75)]'
            }`}>
              {trendDiff < 0 ? (
                <TrendingDown size={16} className="flex-shrink-0" />
              ) : (
                <TrendingUp size={16} className="flex-shrink-0" />
              )}
              <span className="font-medium">
                {trendDiff < 0
                  ? `Your impact is down ${Math.abs(trendDiff)} pts — great improvement!`
                  : `Your impact is up ${trendDiff} pts — try to reduce tomorrow.`}
              </span>
            </div>
          )}
        </div>

        {/* Area Chart */}
        <div className="eco-card p-5 animate-fade-up animate-fade-up-delay-1">
          <h2 className="font-['Fraunces'] font-bold text-base text-foreground mb-4">
            Score Trend (7 days)
          </h2>
          <ResponsiveContainer width="100%" height={160}>
            <AreaChart data={chartData} margin={{ top: 4, right: 4, left: -20, bottom: 0 }}>
              <defs>
                <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor="oklch(0.42 0.12 148)" stopOpacity={0.3} />
                  <stop offset="95%" stopColor="oklch(0.42 0.12 148)" stopOpacity={0} />
                </linearGradient>
              </defs>
              <CartesianGrid strokeDasharray="3 3" stroke="oklch(0.88 0.04 148)" vertical={false} />
              <ReferenceLine y={40} stroke="oklch(0.42 0.12 148)" strokeDasharray="4 4" strokeOpacity={0.5} />
              <ReferenceLine y={70} stroke="oklch(0.72 0.14 75)" strokeDasharray="4 4" strokeOpacity={0.5} />
              <XAxis
                dataKey="day"
                tick={{ fontSize: 10, fill: 'oklch(0.52 0.06 148)' }}
                axisLine={false}
                tickLine={false}
              />
              <YAxis
                domain={[0, 100]}
                tick={{ fontSize: 10, fill: 'oklch(0.52 0.06 148)' }}
                axisLine={false}
                tickLine={false}
              />
              <Tooltip
                contentStyle={{
                  background: 'oklch(0.995 0.005 145)',
                  border: '1px solid oklch(0.88 0.04 148)',
                  borderRadius: 12,
                  fontSize: 12,
                  fontFamily: 'Plus Jakarta Sans',
                }}
                formatter={(v: number) => [`${v} pts`, 'Score']}
                labelFormatter={(l, p) => p[0]?.payload?.date || l}
              />
              <Area
                type="monotone"
                dataKey="score"
                stroke="oklch(0.42 0.12 148)"
                strokeWidth={2.5}
                fill="url(#areaGrad)"
                dot={{ r: 4, fill: 'oklch(0.42 0.12 148)', strokeWidth: 0 }}
                activeDot={{ r: 6 }}
              />
            </AreaChart>
          </ResponsiveContainer>
          <div className="flex items-center gap-4 mt-2 text-[10px] text-muted-foreground">
            <span className="flex items-center gap-1">
              <span className="w-3 h-0.5 bg-primary inline-block rounded" style={{ borderTop: '2px dashed oklch(0.42 0.12 148)' }} />
              Low (≤40)
            </span>
            <span className="flex items-center gap-1">
              <span className="w-3 h-0.5 inline-block rounded" style={{ borderTop: '2px dashed oklch(0.72 0.14 75)' }} />
              Medium (≤70)
            </span>
          </div>
        </div>

        {/* Bar Chart by category */}
        <div className="eco-card p-5 animate-fade-up animate-fade-up-delay-2">
          <h2 className="font-['Fraunces'] font-bold text-base text-foreground mb-4">
            Daily Scores
          </h2>
          <ResponsiveContainer width="100%" height={140}>
            <BarChart data={chartData} margin={{ top: 4, right: 4, left: -20, bottom: 0 }}>
              <XAxis
                dataKey="day"
                tick={{ fontSize: 10, fill: 'oklch(0.52 0.06 148)' }}
                axisLine={false}
                tickLine={false}
              />
              <YAxis
                domain={[0, 100]}
                tick={{ fontSize: 10, fill: 'oklch(0.52 0.06 148)' }}
                axisLine={false}
                tickLine={false}
              />
              <Tooltip
                contentStyle={{
                  background: 'oklch(0.995 0.005 145)',
                  border: '1px solid oklch(0.88 0.04 148)',
                  borderRadius: 12,
                  fontSize: 12,
                  fontFamily: 'Plus Jakarta Sans',
                }}
                formatter={(v: number) => [`${v} pts`, 'Score']}
              />
              <Bar dataKey="score" radius={[6, 6, 0, 0]}>
                {chartData.map((entry, index) => (
                  <Cell key={index} fill={entry.fill} />
                ))}
              </Bar>
            </BarChart>
          </ResponsiveContainer>
        </div>

        {/* Highlights */}
        <div className="grid grid-cols-2 gap-3 animate-fade-up animate-fade-up-delay-3">
          {bestDay && (
            <div className="eco-card p-4 border-l-4 border-l-primary">
              <div className="flex items-center gap-2 mb-2">
                <Award size={16} className="text-primary" />
                <span className="text-xs font-semibold text-primary uppercase tracking-wide">Best Day</span>
              </div>
              <p className="font-['Fraunces'] font-black text-2xl text-primary">{bestDay.score}</p>
              <p className="text-xs text-muted-foreground">{formatDate(bestDay.date)} · {getDayLabel(bestDay.date)}</p>
              <ScoreBar score={bestDay.score} />
            </div>
          )}
          {worstDay && (
            <div className="eco-card p-4 border-l-4 border-l-[oklch(0.577_0.245_27.325)]">
              <div className="flex items-center gap-2 mb-2">
                <AlertTriangle size={16} className="text-destructive" />
                <span className="text-xs font-semibold text-destructive uppercase tracking-wide">Worst Day</span>
              </div>
              <p className="font-['Fraunces'] font-black text-2xl text-destructive">{worstDay.score}</p>
              <p className="text-xs text-muted-foreground">{formatDate(worstDay.date)} · {getDayLabel(worstDay.date)}</p>
              <ScoreBar score={worstDay.score} />
            </div>
          )}
        </div>

        {/* Category breakdown */}
        <div className="eco-card p-5 animate-fade-up animate-fade-up-delay-4">
          <h2 className="font-['Fraunces'] font-bold text-base text-foreground mb-4">
            Impact Distribution
          </h2>
          <div className="space-y-3">
            {(['Low', 'Medium', 'High'] as const).map((cat) => {
              const count = categoryCounts[cat] || 0;
              const pct = recent7.length > 0 ? (count / recent7.length) * 100 : 0;
              const color =
                cat === 'Low' ? 'oklch(0.42 0.12 148)' :
                cat === 'Medium' ? 'oklch(0.72 0.14 75)' :
                'oklch(0.577 0.245 27.325)';
              return (
                <div key={cat} className="flex items-center gap-3">
                  <span className="text-xs font-semibold w-16 text-foreground">{cat}</span>
                  <div className="flex-1 h-3 bg-muted rounded-full overflow-hidden">
                    <div
                      className="h-full rounded-full transition-all duration-700"
                      style={{ width: `${pct}%`, background: color }}
                    />
                  </div>
                  <span className="text-xs text-muted-foreground w-12 text-right">
                    {count} day{count !== 1 ? 's' : ''}
                  </span>
                </div>
              );
            })}
          </div>
        </div>

        {/* Log History */}
        <div className="eco-card p-5 animate-fade-up animate-fade-up-delay-5">
          <h2 className="font-['Fraunces'] font-bold text-base text-foreground mb-4">
            Log History
          </h2>
          <div className="space-y-2">
            {[...logs].reverse().slice(0, 10).map((log: DailyLog) => (
              <div key={log.date} className="flex items-center gap-3 py-2 border-b border-border/40 last:border-0">
                <div className="text-center w-10">
                  <p className="text-xs font-bold text-foreground">{getDayLabel(log.date)}</p>
                  <p className="text-[10px] text-muted-foreground">{formatDate(log.date)}</p>
                </div>
                <div className="flex-1 min-w-0">
                  <div className="flex items-center gap-1.5 flex-wrap">
                    <span className="text-xs bg-muted px-2 py-0.5 rounded-full capitalize">{log.transport}</span>
                    <span className="text-xs bg-muted px-2 py-0.5 rounded-full capitalize">{log.food}</span>
                    <span className="text-xs bg-muted px-2 py-0.5 rounded-full capitalize">{log.energy}</span>
                  </div>
                </div>
                <div className="text-right flex-shrink-0">
                  <p
                    className="text-sm font-['Fraunces'] font-black"
                    style={{
                      color:
                        log.score <= 40 ? 'oklch(0.42 0.12 148)' :
                        log.score <= 70 ? 'oklch(0.72 0.14 75)' :
                        'oklch(0.577 0.245 27.325)',
                    }}
                  >
                    {log.score}
                  </p>
                  <p className="text-[10px] text-muted-foreground">{log.category}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}
