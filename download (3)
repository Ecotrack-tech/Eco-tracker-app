/**
 * ONBOARDING FLOW — Biophilic Minimalism
 * 3-screen flow: Welcome → Goal Selection → Habit Tips
 * First-time users see this before the dashboard.
 */
import { useEffect, useState } from 'react';
import { useOnboarding } from '@/contexts/OnboardingContext';
import { useEco } from '@/contexts/EcoContext';
import type { GoalType } from '@/lib/ecoStore';
import { useLocation } from 'wouter';
import { onboardingEvents } from '@/lib/analytics';
import {
  Leaf, Bike, Salad, Zap, ArrowRight, CheckCircle2,
  Lightbulb, Sprout, Heart, Zap as ZapIcon,
} from 'lucide-react';

const HERO_BG = 'https://d2xsxph8kpxj0f.cloudfront.net/310519663491038184/8mo3sACQc5FWLikvSwLvEv/eco-hero-bg-BXsFzNLcXHvo4ZVUKqsU6H.webp';
const HABITS_IMG = 'https://d2xsxph8kpxj0f.cloudfront.net/310519663491038184/8mo3sACQc5FWLikvSwLvEv/eco-habits-illustration-FRzUT4oePUbKd5Tc8kQnf6.webp';

type OnboardingStep = 'welcome' | 'goal' | 'tips';

const GOAL_OPTIONS: Array<{ type: GoalType; title: string; description: string; icon: React.ReactNode; color: string }> = [
  {
    type: 'transport',
    title: 'Reduce Transport Emissions',
    description: 'Walk, cycle, or use public transport instead of driving.',
    icon: <Bike size={32} />,
    color: 'oklch(0.42 0.12 148)',
  },
  {
    type: 'food',
    title: 'Eat Less Meat',
    description: 'Choose plant-based meals to lower your food footprint.',
    icon: <Salad size={32} />,
    color: 'oklch(0.55 0.13 148)',
  },
  {
    type: 'energy',
    title: 'Lower Energy Usage',
    description: 'Keep your home energy consumption low each day.',
    icon: <ZapIcon size={32} />,
    color: 'oklch(0.72 0.14 75)',
  },
];

const TIPS = [
  {
    icon: <Sprout size={28} />,
    title: 'Small Steps, Big Impact',
    description: 'Every choice matters. Even small changes add up to make a real difference for the planet.',
  },
  {
    icon: <Heart size={28} />,
    title: 'Build a Daily Habit',
    description: 'Logging takes just 60 seconds. The more consistent you are, the easier it becomes.',
  },
  {
    icon: <Lightbulb size={28} />,
    title: 'Get Personalized Tips',
    description: "After each log, you'll receive suggestions tailored to your habits to help you improve."
  },
];

export default function Onboarding() {
  const { completeOnboarding } = useOnboarding();
  const { setGoal } = useEco();
  const [, navigate] = useLocation();
  const [step, setStep] = useState<OnboardingStep>('welcome');
  const [selectedGoal, setSelectedGoal] = useState<GoalType | null>(null);

  // Track onboarding start
  useEffect(() => {
    onboardingEvents.started();
  }, []);

  // Track screen views
  useEffect(() => {
    if (step === 'welcome') {
      onboardingEvents.welcomeViewed();
    } else if (step === 'goal') {
      onboardingEvents.goalScreenViewed();
    } else if (step === 'tips') {
      onboardingEvents.tipsScreenViewed();
    }
  }, [step]);

  const handleSkip = () => {
    onboardingEvents.skipped();
    completeOnboarding();
    navigate('/');
  };

  const handleGoalSelect = (type: GoalType) => {
    setSelectedGoal(type);
    setGoal(type);
    onboardingEvents.goalSelected(type);
  };

  const handleFinish = () => {
    onboardingEvents.completed();
    completeOnboarding();
    navigate('/');
  };

  // ─── SCREEN 1: WELCOME ──────────────────────────────────────────────────────

  if (step === 'welcome') {
    return (
      <div className="min-h-screen flex flex-col">
        {/* Hero */}
        <div
          className="relative overflow-hidden flex-1 flex items-end justify-center"
          style={{
            background: `url(${HERO_BG}) center/cover no-repeat`,
            minHeight: 300,
          }}
        >
          <div className="absolute inset-0 bg-gradient-to-b from-white/0 via-white/20 to-white" />
          <div className="relative z-10 text-center px-4 pb-12 animate-fade-up">
            <Leaf size={48} className="text-primary mx-auto mb-4" />
            <h1 className="font-['Fraunces'] font-black text-4xl text-foreground leading-tight mb-2">
              Welcome to<br />
              <span className="italic text-primary">Eco Tracker</span>
            </h1>
            <p className="text-sm text-muted-foreground max-w-xs mx-auto">
              Track your daily habits and reduce your environmental impact, one choice at a time.
            </p>
          </div>
        </div>

        {/* Content */}
        <div className="flex-1 px-4 py-8 space-y-4 flex flex-col justify-between">
          <div className="space-y-4 animate-fade-up animate-fade-up-delay-1">
            {[
              { icon: '📊', title: 'Track Daily Habits', desc: 'Log your transport, food, energy, and shopping in 60 seconds.' },
              { icon: '🎯', title: 'Get Your Eco Score', desc: 'See your daily impact score and understand your footprint.' },
              { icon: '💡', title: 'Receive Tips', desc: 'Get personalized suggestions to reduce your environmental impact.' },
            ].map((item, i) => (
              <div key={i} className="flex items-start gap-3">
                <span className="text-2xl flex-shrink-0">{item.icon}</span>
                <div>
                  <p className="font-semibold text-foreground text-sm">{item.title}</p>
                  <p className="text-xs text-muted-foreground">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div className="space-y-3 animate-fade-up animate-fade-up-delay-2">
            <button
              onClick={() => setStep('goal')}
              className="w-full flex items-center justify-center gap-2 bg-primary text-primary-foreground py-3.5 rounded-2xl font-semibold text-sm hover:bg-primary/90 transition-colors active:scale-[0.98]"
            >
              Get Started
              <ArrowRight size={16} />
            </button>
            <button
              onClick={handleSkip}
              className="w-full py-2.5 rounded-2xl font-semibold text-sm text-muted-foreground hover:text-foreground transition-colors"
            >
              Skip for now
            </button>
          </div>
        </div>
      </div>
    );
  }

  // ─── SCREEN 2: GOAL SELECTION ───────────────────────────────────────────────

  if (step === 'goal') {
    return (
      <div className="min-h-screen flex flex-col pb-24">
        {/* Header */}
        <div className="px-4 pt-10 pb-4 animate-fade-up">
          <div className="flex items-center justify-between mb-4">
            <button
              onClick={() => setStep('welcome')}
              className="text-muted-foreground hover:text-foreground transition-colors"
            >
              ← Back
            </button>
            <span className="text-xs font-semibold text-primary uppercase tracking-widest">Step 1 of 2</span>
          </div>
          <h1 className="font-['Fraunces'] font-black text-2xl text-foreground mb-1">
            Choose Your Focus Goal
          </h1>
          <p className="text-sm text-muted-foreground">
            Pick one area to focus on first. You can change this anytime.
          </p>
        </div>

        {/* Goal Options */}
        <div className="px-4 space-y-3 flex-1 animate-fade-up animate-fade-up-delay-1">
          {GOAL_OPTIONS.map((option) => (
            <button
              key={option.type}
              onClick={() => handleGoalSelect(option.type)}
              className={`w-full eco-card p-5 text-left transition-all duration-200 ${
                selectedGoal === option.type
                  ? 'border-2 shadow-md'
                  : 'hover:border-border/80 hover:shadow-sm'
              }`}
              style={selectedGoal === option.type ? { borderColor: option.color } : {}}
            >
              <div className="flex items-start gap-4">
                <div
                  className="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0"
                  style={{
                    background: `${option.color}18`,
                    color: option.color,
                  }}
                >
                  {option.icon}
                </div>
                <div className="flex-1 min-w-0">
                  <div className="flex items-center gap-2 mb-0.5">
                    <p className="text-sm font-semibold text-foreground">{option.title}</p>
                    {selectedGoal === option.type && (
                      <CheckCircle2 size={16} style={{ color: option.color }} />
                    )}
                  </div>
                  <p className="text-xs text-muted-foreground">{option.description}</p>
                </div>
              </div>
            </button>
          ))}
        </div>

        {/* Next Button */}
        <div className="px-4 space-y-3 mt-4 animate-fade-up animate-fade-up-delay-2">
          <button
            onClick={() => setStep('tips')}
            disabled={!selectedGoal}
            className="w-full flex items-center justify-center gap-2 bg-primary text-primary-foreground py-3.5 rounded-2xl font-semibold text-sm transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-primary/90 active:scale-[0.98]"
          >
            Continue
            <ArrowRight size={16} />
          </button>
        </div>
      </div>
    );
  }

  // ─── SCREEN 3: HABIT TIPS ───────────────────────────────────────────────────

  if (step === 'tips') {
    return (
      <div className="min-h-screen flex flex-col pb-24">
        {/* Header */}
        <div className="px-4 pt-10 pb-4 animate-fade-up">
          <div className="flex items-center justify-between mb-4">
            <button
              onClick={() => setStep('goal')}
              className="text-muted-foreground hover:text-foreground transition-colors"
            >
              ← Back
            </button>
            <span className="text-xs font-semibold text-primary uppercase tracking-widest">Step 2 of 2</span>
          </div>
          <h1 className="font-['Fraunces'] font-black text-2xl text-foreground mb-1">
            Tips to Get Started
          </h1>
          <p className="text-sm text-muted-foreground">
            Here's how to make the most of your eco journey.
          </p>
        </div>

        {/* Habits Image */}
        <div className="px-4 mb-6 animate-fade-up animate-fade-up-delay-1">
          <img
            src={HABITS_IMG}
            alt="Eco habits"
            className="w-full rounded-2xl"
          />
        </div>

        {/* Tips */}
        <div className="px-4 space-y-3 flex-1 animate-fade-up animate-fade-up-delay-2">
          {TIPS.map((tip, i) => (
            <div key={i} className="eco-card p-4 flex gap-3">
              <div
                className="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0"
                style={{ background: 'oklch(0.93 0.04 148)', color: 'oklch(0.42 0.12 148)' }}
              >
                {tip.icon}
              </div>
              <div>
                <p className="font-semibold text-foreground text-sm">{tip.title}</p>
                <p className="text-xs text-muted-foreground mt-0.5">{tip.description}</p>
              </div>
            </div>
          ))}
        </div>

        {/* Finish Button */}
        <div className="px-4 space-y-3 mt-4 animate-fade-up animate-fade-up-delay-3">
          <button
            onClick={handleFinish}
            className="w-full flex items-center justify-center gap-2 bg-primary text-primary-foreground py-3.5 rounded-2xl font-semibold text-sm hover:bg-primary/90 transition-colors active:scale-[0.98]"
          >
            <CheckCircle2 size={16} />
            Start Tracking
          </button>
        </div>
      </div>
    );
  }
}
